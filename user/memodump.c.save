
void
memdump(char *fmt, char *data, int len)
{
  int off = 0;
  for (char *f = fmt; *f; f++) {
    char c = *f;
    int need = (c == 'i') ? 4 : (c == 'p' || c == 's') ? 8 :
               (c == 'h') ? 2 : (c == 'c') ? 1 : 0;

    if (c == 'S') {
      int i = off;
      while (i < len && data[i] != 0) {
        write(1, data + i, 1);
        i++;
      }
      write(1, "\n", 1);
      return; // S consumes the rest of the data
    }

    if (off + need > len) {
      printf("memdump: not enough data for '%c'\n", c);
      return;
    }

    if (c == 'i') {
      int v;
      memmove(&v, data + off, 4);
      printf("%d\n", v);
    } else if (c == 'p') {
      uint64 v;
      memmove(&v, data + off, 8);
      printf("%lx\n", v);
    } else if (c == 'h') {
      short v;
      memmove(&v, data + off, 2);
      printf("%d\n", v);
    } else if (c == 'c') {
      printf("%c\n", data[off]);
    } else if (c == 's') {
      char *p;
      memmove(&p, data + off, 8);
      printf("%s\n", p);
    } else {
      printf("memdump: unknown format '%c'\n", c);
      return;
    }
    off += need;
  }
}
